# App
APP_PORT=3005

## Login (proxy al nextAPI de Spring Telecom)
LOGIN_API_URL=https://springtelecom.mx/nextAPI/api/login

## Mercado Pago (SPEI requiere credenciales APP_USR — Orders API no acepta TEST-)
MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000

## Comprador de prueba (@testuser.com) — solo sandbox
MP_TEST_BUYER_EMAIL=

## URL pública configurada en el panel de MP (evento "Pagos")
MP_WEBHOOK_URL=https://tudominio.com/api/spei/webhook

## Opcional: reenvío de eventos procesados a otra API. Vacío = desactivado.
MP_WEBHOOK_FORWARD_URL=

## Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=usuario
DB_PASSWORD=password
DB_NAME=MercadoPagoBD
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_TIMEZONE=-06:00
